# Copy to .env.production on the VPS:
#   cp .env.production.example .env.production

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels)
# Required for: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Public site / API (nginx proxies /api → FastAPI)
NEXT_PUBLIC_API_URL=/api

# FastAPI CORS (comma-separated)
CORS_ORIGIN=https://notascore.com,https://www.notascore.com

# Upload limits
MAX_UPLOAD_MB=25

# Redis (override is also set in docker-compose.yml)
REDIS_URL=redis://redis:6379
QUEUE_NAME=transcription

# SQLite on the shared dbdata volume
DATABASE_URL=sqlite:////app/data/audio2score.db

# Local disk storage (Docker volumes)
UPLOAD_DIR=/app/uploads
RESULTS_DIR=/app/results
TEMP_DIR=/app/.tmp

# Leave empty for local disk storage (recommended for MVP)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_AUDIO=audio-uploads
SUPABASE_BUCKET_RESULTS=musicxml-exports

# Fast mode = Basic Pitch on this VM (see transcription.py)
TRANSCRIPTION_ENGINE=basic_pitch

# Quality / Polyphonic = YourMT3 remote GPU. POST audio, receive MIDI.
# Example: MT3_ENDPOINT=http://gpu-worker:8090/transcribe
MT3_ENDPOINT=
MT3_API_KEY=
MT3_MODEL=yourmt3
MT3_TRANSCRIBE_COMMAND=
MT3_TIMEOUT_SECONDS=300

TRANSCRIPTION_PIPELINE=understanding
TRANSCRIPTION_PIPELINE_FALLBACK=1
TRANSCRIPTION_BACKEND=basic_pitch
TRANSCRIPTION_USE_CLEANER=1
TRANSCRIPTION_USE_NORMALIZER=1
TRANSCRIPTION_USE_BEAT_TRACKER=1
TRANSCRIPTION_USE_PIANO_ANALYZER=1
TRANSCRIPTION_USE_MIR_LAYERS=1
TRANSCRIPTION_SHADOW_CLEANER=0

# MVP transcription quality (source-aware defaults if unset)
# TRANSCRIPTION_VALIDATION_MODE=safe|conservative|legacy_aggressive
# TRANSCRIPTION_QUANTIZATION_MODE=adaptive
TRANSCRIPTION_ENABLE_GEMINI=0
# TRANSCRIPTION_ENABLE_PIANO_ANALYSIS=  # empty: on for Basic Pitch, off for MT3

# Gemini music intelligence — leave off until GEMINI_API_KEY is set.
ENABLE_GEMINI_MUSIC_ANALYSIS=0
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash
ENABLE_GEMINI_DEEP_ANALYSIS=0
