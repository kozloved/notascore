# Copy to .env.production on the VPS:
#   cp .env.production.example .env.production

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels)
# Required for: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Public site / API (nginx proxies /api → FastAPI)
NEXT_PUBLIC_API_URL=/api

# FastAPI CORS (comma-separated)
CORS_ORIGIN=https://notascore.com,https://www.notascore.com

# Upload limits
MAX_UPLOAD_MB=25

# Redis (override is also set in docker-compose.yml)
REDIS_URL=redis://redis:6379
QUEUE_NAME=transcription

# SQLite on the shared dbdata volume
DATABASE_URL=sqlite:////app/data/audio2score.db

# Local disk storage (Docker volumes)
UPLOAD_DIR=/app/uploads
RESULTS_DIR=/app/results
TEMP_DIR=/app/.tmp

# Leave empty for local disk storage (recommended for MVP)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET_AUDIO=audio-uploads
SUPABASE_BUCKET_RESULTS=musicxml-exports

# Fast mode = Basic Pitch on this VM (see transcription.py)
TRANSCRIPTION_ENGINE=basic_pitch

# Quality / Polyphonic = YourMT3 remote GPU. POST audio, receive MIDI.
# RunPod Serverless (copy the ID from the RunPod console URL):
#   MT3_ENDPOINT=https://api.runpod.ai/v2/<ENDPOINT_ID>/runsync
#   MT3_API_KEY=<RunPod API key from Settings → API Keys>
# Legacy multipart worker: MT3_ENDPOINT=http://gpu-worker:8090/transcribe
MT3_ENDPOINT=
MT3_API_KEY=
MT3_MODEL=yourmt3
MT3_TRANSCRIBE_COMMAND=
MT3_TIMEOUT_SECONDS=600

TRANSCRIPTION_PIPELINE=understanding
TRANSCRIPTION_PIPELINE_FALLBACK=1
TRANSCRIPTION_BACKEND=basic_pitch
TRANSCRIPTION_USE_CLEANER=1
TRANSCRIPTION_USE_NORMALIZER=1
TRANSCRIPTION_USE_BEAT_TRACKER=1
TRANSCRIPTION_USE_PIANO_ANALYZER=1
TRANSCRIPTION_USE_MIR_LAYERS=1
TRANSCRIPTION_SHADOW_CLEANER=0

# MVP transcription quality (source-aware defaults if unset)
# TRANSCRIPTION_VALIDATION_MODE=safe|conservative|legacy_aggressive
# TRANSCRIPTION_QUANTIZATION_MODE=off
#   off = keep transcribed timing; MusicXML uses tied 64th-based note types
#   (not a forced 32nd onset grid). adaptive | strict_grid = notation rewrite.
#   pm2s = PM2S quantization RNN (opt-in; needs torch + PM2S_REPO). Falls back to off.
# TRANSCRIPTION_HAND_SEPARATOR=viterbi
#   Hands only: viterbi | pm2s. Do not set this to performance.
#   performance is TRANSCRIPTION_QUANTIZATION_MODE.
#   Leave viterbi in production. For a PM2S A/B on the worker:
#     TRANSCRIPTION_HAND_SEPARATOR=pm2s
#     TRANSCRIPTION_QUANTIZATION_MODE=pm2s
#     PM2S_REPO=/opt/pm2s
#     TRANSCRIPTION_PM2S_REQUIRED=1
#   Requires torch + https://github.com/cheriell/PM2S cloned at PM2S_REPO.
#   Hands and quantization are independent flags.
#   For a local test checkout: audio2score-week4/backend/scripts/setup_pm2s.sh
TRANSCRIPTION_ENABLE_GEMINI=0
# TRANSCRIPTION_ENABLE_PIANO_ANALYSIS=  # empty: on for Basic Pitch, off for MT3

# ============================================================
# NEXT-GEN PRODUCTION PIPELINE
# ============================================================
#
# Next-Gen live does not mean all experimental models are enabled.
# The first cutover only promotes PipelineOrchestrator to the production
# job owner. The Python fallback remains NEXTGEN_PIPELINE_MODE=legacy if
# this file is missing.
#
# Production orchestrator: legacy | shadow | live
NEXTGEN_PIPELINE_MODE=live

# Optional federation stages.
# Keep OFF for the first live cutover.
NEXTGEN_SEPARATION_ENABLED=0
NEXTGEN_SEPARATION_BACKEND=auto
# Leave blank unless a real configured separator service exists.
SEPARATION_ENDPOINT=

NEXTGEN_STEM_TRANSCRIPTION_ENABLED=0
NEXTGEN_FUSION_ENABLED=0

# Experimental providers — do not enable yet.
NEXTGEN_TRANSKUN=0
NEXTGEN_BEAT_THIS=0

# Ensemble score rendering remains disabled.
NEXTGEN_ENSEMBLE_RENDER=0

# Write manifest/provenance artifacts.
NEXTGEN_WRITE_MANIFEST=1

# Gemini music intelligence — leave off until GEMINI_API_KEY is set.
ENABLE_GEMINI_MUSIC_ANALYSIS=0
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash
ENABLE_GEMINI_DEEP_ANALYSIS=0
