# Same-origin /api. Production nginx proxies /api → FastAPI.
# Local next dev uses next.config rewrites to http://127.0.0.1:8000.
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://127.0.0.1:8000

# Optional. Used for sitemap and Open Graph absolute URLs.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional Supabase auth. Leave unset to keep sign-in disabled.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
