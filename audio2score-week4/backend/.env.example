# App
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25

# Database
DATABASE_URL=sqlite:///./audio2score.db

# Redis Queue
REDIS_URL=redis://localhost:6379
QUEUE_NAME=transcription

# Local storage directories
UPLOAD_DIR=uploads
RESULTS_DIR=results
TEMP_DIR=.tmp

# Supabase optional
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_AUDIO=audio-uploads
SUPABASE_BUCKET_RESULTS=musicxml-exports

# Transcription engine (health display)
TRANSCRIPTION_ENGINE=basic_pitch

# Pipeline: legacy | understanding (default: understanding)
TRANSCRIPTION_PIPELINE=understanding

# Fall back to legacy Basic Pitch if understanding pipeline raises (1 | 0)
TRANSCRIPTION_PIPELINE_FALLBACK=1

# MIR layers: hand/voice separation, dynamics, articulation, phrases (1 | 0)
TRANSCRIPTION_USE_MIR_LAYERS=1

# Backend when using understanding pipeline: basic_pitch | classical_dsp | mt3
TRANSCRIPTION_BACKEND=basic_pitch

# Apply MIDICleaner on legacy Basic Pitch path (1 | 0)
# Synthetic fixtures promote this to 1; keep shadow mode first on production audio.
TRANSCRIPTION_USE_CLEANER=1

# Phase 2 legacy enhancements (default on; set 0 to disable individually)
TRANSCRIPTION_USE_NORMALIZER=1
TRANSCRIPTION_USE_BEAT_TRACKER=1
TRANSCRIPTION_USE_PIANO_ANALYZER=1

# Log cleaner delta without changing output when USE_CLEANER=0 (1 | 0)
TRANSCRIPTION_SHADOW_CLEANER=0

# Fast-mode Basic Pitch knobs (poly piano: fewer ghost onsets / twitter octaves)
BASIC_PITCH_ONSET_THRESHOLD=0.6
BASIC_PITCH_FRAME_THRESHOLD=0.4
BASIC_PITCH_MIN_NOTE_LENGTH_MS=127.70
BASIC_PITCH_MIN_FREQ_HZ=27.5
BASIC_PITCH_MAX_FREQ_HZ=2093.0
BASIC_PITCH_MELODIA_TRICK=1
BASIC_PITCH_MULTIPLE_PITCH_BENDS=0

# Quality mode (MR-MT3). Fast jobs ignore these.
# Point at a GPU worker that POSTs audio and returns MIDI, or a command
# that writes MIDI to {output}. Leave both empty to keep Quality disabled.
# GPU setup: audio2score-week4/gpu-worker/README.md (RTX 4000 Ada 20GB is enough)
MT3_ENDPOINT=
MT3_API_KEY=
MT3_TRANSCRIBE_COMMAND=
MT3_TIMEOUT_SECONDS=300

# Gemini music intelligence (optional). Off by default. Never replaces Fast/Quality
# note detection. If the API fails, transcription still completes.
# Default model (Aug 2026): gemini-2.5-flash-lite is the cheapest Gemini
# audio+JSON analyser (~$0.30/1M audio tokens). gemini-3.6-flash is stronger
# but ~5–15× more expensive. OpenAI gpt-4o-mini-audio is ~$10/1M audio tokens.
ENABLE_GEMINI_MUSIC_ANALYSIS=0
GEMINI_ENABLED=0
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-lite
GEMINI_REASONING_MODEL=gemini-2.5-flash
ENABLE_GEMINI_AUDIO_INPUT=1
ENABLE_GEMINI_DEEP_ANALYSIS=0
GEMINI_DEEP_ANALYSIS_ENABLED=0
ENABLE_GEMINI_MIDI_VALIDATION=1
ENABLE_GEMINI_STRUCTURE_ANALYSIS=1
GEMINI_AUTO_APPLY_THRESHOLD=0.90
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_AUDIO_SECONDS=60
MUSIC_ANALYSIS_PROVIDER=gemini
