# App
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25

# Database
DATABASE_URL=sqlite:///./audio2score.db

# Redis Queue
REDIS_URL=redis://localhost:6379
QUEUE_NAME=transcription

# Local storage directories
UPLOAD_DIR=uploads
RESULTS_DIR=results
TEMP_DIR=.tmp

# Supabase optional
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_AUDIO=audio-uploads
SUPABASE_BUCKET_RESULTS=musicxml-exports

# Transcription engine (health display)
TRANSCRIPTION_ENGINE=basic_pitch

# Pipeline: legacy | understanding (default: understanding)
TRANSCRIPTION_PIPELINE=understanding

# Fall back to legacy Basic Pitch if understanding pipeline raises (1 | 0)
TRANSCRIPTION_PIPELINE_FALLBACK=1

# MIR layers: hand/voice separation, dynamics, articulation, phrases (1 | 0)
TRANSCRIPTION_USE_MIR_LAYERS=1

# Backend when using understanding pipeline: basic_pitch | classical_dsp | mt3
TRANSCRIPTION_BACKEND=basic_pitch

# Apply MIDICleaner on legacy Basic Pitch path (1 | 0)
# Synthetic fixtures promote this to 1; keep shadow mode first on production audio.
TRANSCRIPTION_USE_CLEANER=1

# Phase 2 legacy enhancements (default on; set 0 to disable individually)
TRANSCRIPTION_USE_NORMALIZER=1
TRANSCRIPTION_USE_BEAT_TRACKER=1
TRANSCRIPTION_USE_PIANO_ANALYZER=1

# Log cleaner delta without changing output when USE_CLEANER=0 (1 | 0)
TRANSCRIPTION_SHADOW_CLEANER=0
