# App
CORS_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=25

# Database
DATABASE_URL=sqlite:///./audio2score.db

# Redis Queue
REDIS_URL=redis://localhost:6379
QUEUE_NAME=transcription

# Local storage directories
UPLOAD_DIR=uploads
RESULTS_DIR=results
TEMP_DIR=.tmp

# Supabase optional
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_AUDIO=audio-uploads
SUPABASE_BUCKET_RESULTS=musicxml-exports

# Transcription engine
# Options: placeholder | command
TRANSCRIPTION_ENGINE=placeholder

# Command engine settings
# The command must accept {input} and {output}.
# Example:
# MT3_TRANSCRIBE_COMMAND=python scripts/example_mt3.py {input} {output}
MT3_TRANSCRIBE_COMMAND=
MT3_TIMEOUT_SECONDS=300
